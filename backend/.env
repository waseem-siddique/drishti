ENVIRONMENT=local
DATABASE_URL=sqlite:///./drishti.db
# PostgreSQL: postgresql+psycopg://drishti:drishti@localhost:5432/drishti
JWT_SECRET=change-me-before-any-shared-deployment
SESSION_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
UPLOAD_DIR=./var/uploads
EVIDENCE_DIR=./var/evidence
MAX_UPLOAD_MB=64
SIMILARITY_BACKEND=lexical

# Model configuration lives here only. Never hardcode a model id in application code.
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

NEXT_PUBLIC_API_URL=http://localhost:8000
